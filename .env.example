GOOGLE_MAPS_API_KEY=[your_api_key_here]
APP_PORT=8001
SECRET_KEY=[dev_secret_key_change_me_in_prod]
DEBUG=True
ALLOWED_HOSTS=*
# For HTTPS production, add your domain (e.g., https://your-domain.com)
CSRF_TRUSTED_ORIGINS=https://localhost

# Postgres
POSTGRES_DB=routefinder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/routefinder

# Default Admin
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=adminpass

# AI (Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b

# Offline Mock Mode (set to True to bypass all external APIs)
MOCK_MODE=False

# OpenID Connect (Authentik) Configuration
OIDC_ENABLED=False
OIDC_ADMIN_GROUP=authentik Admins
OIDC_REQUIRED_GROUP=
OIDC_RP_CLIENT_ID=routefinder-oidc-client
OIDC_RP_CLIENT_SECRET=change-me-in-infisical
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.castertr0y357.net/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.castertr0y357.net/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.castertr0y357.net/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.castertr0y357.net/application/o/routefinder/jwks/
OIDC_OP_LOGOUT_ENDPOINT=https://auth.castertr0y357.net/application/o/routefinder/end-session/
