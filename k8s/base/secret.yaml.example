apiVersion: v1
kind: Secret
metadata:
  name: routefinder-secret
type: Opaque
stringData:
  # Secret key and database credentials
  SECRET_KEY: "change-me-to-a-secure-random-secret-key-for-production"
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "change-me-to-a-secure-database-password"
  GOOGLE_MAPS_API_KEY: "change-me-to-your-google-maps-api-key"
  DEFAULT_ADMIN_USER: "admin"
  DEFAULT_ADMIN_EMAIL: "admin@example.com"
  DEFAULT_ADMIN_PASSWORD: "change-me-to-a-secure-admin-password"
